### verify_manifest.rb source
# Verifies a target's .ai/manifest.yml: safe YAML (no aliases), every entry a repo-relative .ai/ path
# with a 64-hex SHA-256, every entry present on disk with a matching hash, and reports .ai/ files not listed.
require "yaml"; require "digest"
root = File.expand_path(ARGV.fetch(0))
path = File.join(root, ".ai/manifest.yml")
doc = YAML.safe_load(File.read(path), aliases: false, permitted_classes: [])
files = doc.fetch("files")
puts "manifest version: #{doc['version']}  soft_foundry_version: #{doc['soft_foundry_version']}"
on_disk = Dir.chdir(root) { Dir.glob(".ai/**/*", File::FNM_DOTMATCH).select { |f| File.file?(f) } } - [".ai/manifest.yml"]
puts "files under .ai/ on disk (excluding manifest): #{on_disk.size}"
puts "manifest entries: #{files.size}"
puts "on disk but not in manifest: #{(on_disk - files.keys).sort.inspect}"
puts "in manifest but not on disk: #{(files.keys - on_disk).sort.inspect}"
malformed = files.reject { |k, v| k.start_with?(".ai/") && !k.include?("..") && !k.start_with?("/") && v.is_a?(String) && v.match?(/\A[0-9a-f]{64}\z/) }
outside = files.keys.reject { |k| k.start_with?(".ai/") }
mismatch = files.select { |k, v| File.file?(File.join(root, k)) && Digest::SHA256.file(File.join(root, k)).hexdigest != v }.keys
puts "hash mismatches: #{mismatch.size} #{mismatch.inspect}"
puts "malformed entries: #{malformed.size}"
puts "paths outside .ai/: #{outside.inspect}"
exit((mismatch.empty? && malformed.empty? && outside.empty? && (files.keys - on_disk).empty?) ? 0 : 1)
